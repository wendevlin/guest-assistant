# Guest Assistant reads these at start-up (Bun loads .env automatically).
# Everything else is set up in the admin page at http://localhost:3001/admin/

# Port guests connect to; standalone, the admin page is under /admin/ on it.
# PORT=3001

# Where the SQLite database is stored.
# DATA_DIR=data

# Serve the guest frontend from a checkout of guest-assistant-frontend
# (repository root; its guest-assistant/dist is served) instead of ./public.
# GUEST_ASSISTANT_FRONTEND_REPO=../guest-assistant-frontend

# An old config.yaml is imported once into an empty database.
# CONFIG_FILE=config.yaml
